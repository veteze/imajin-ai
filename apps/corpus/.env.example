# Corpus Service — per-DID corpus indexing and BM25 search (#1726)
#
# Not a web app — no Next.js, no browser-facing routes. Runs standalone via
# `npm start` (tsx src/index.ts). Internal-only: called over the LAN by the
# kernel (CORPUS_SERVICE_URL, apps/kernel/.env.example) and MCP tools. The
# localhost default kernel falls back to is only valid when kernel and corpus
# are colocated on the same host — point CORPUS_SERVICE_URL elsewhere if not.

# HTTP port. Defaults to 8003 if unset (src/index.ts). dev-jin and prod-jin
# (and every dev-*/prod-* pm2 pair) run side by side on the same host, so
# dev and prod corpus can't share a port: prod uses 8003 (this file's default,
# below, is the local-dev value), dev uses 8013. See
# deploy/ecosystem.{dev,prod}.config.js's dev-corpus/prod-corpus comments.
PORT=8013

# Kernel's Ed25519 *public* signing key, hex-encoded — the public half of the
# kernel's own AUTH_PRIVATE_KEY (apps/kernel/.env.example), pinned here so
# corpus can verify kernel-minted CorpusAccessClaims locally (see PR #2024).
# Corpus must NEVER be given the kernel's private key: this is a pinned
# pubkey copied out-of-band, not something corpus derives or fetches.
CORPUS_KERNEL_PUBLIC_KEY=

# Corpus service identity (#1750/#1751) — the *opposite* direction key pair
# from CORPUS_KERNEL_PUBLIC_KEY above: this is corpus's own Ed25519 DID +
# private key, used to sign IngestionAttestations at ingest time. Minted via
# `npx tsx scripts/bootstrap-corpus-identity.ts`. The kernel must NEVER be
# given this private key, symmetrically to the rule above. If unset, ingest
# still succeeds — the corpus service just skips signing attestations and
# logs a one-time warning (see src/lib/corpus-identity.ts).
CORPUS_DID=
CORPUS_DID_PRIVATE_KEY=

# Kernel internal-attestation forwarding (#1750): corpus fire-and-forgets
# every signed IngestionAttestation to the kernel's durable auth.attestations
# via POST {AUTH_SERVICE_URL}/api/attestations/internal, mirroring
# packages/auth/src/emit-attestation.ts's two-phase pattern. AUTH_SERVICE_URL
# is the kernel's own base URL (apps/kernel/.env.example's AUTH_SERVICE_URL —
# same value, since corpus talks to the same kernel). ATTESTATION_INTERNAL_API_KEY
# must match the kernel's own env var of the same name (apps/kernel/.env.example) —
# note this is intentionally NOT the same var emit-attestation.ts sends
# (AUTH_INTERNAL_API_KEY); the internal route only ever checks
# ATTESTATION_INTERNAL_API_KEY, so corpus sends that one directly. If either
# is unset, or the kernel is unreachable, forwarding fails locally
# (recorded as forwarded_at=null, forward_error=<message>) and is retried,
# bounded, on the next ingest — it never blocks or fails the ingest itself.
AUTH_SERVICE_URL=
ATTESTATION_INTERNAL_API_KEY=

# GitHub adapter token (optional — only read when ingesting a
# "github:owner/repo" source). Falls back to GH_TOKEN, then to the `gh` CLI's
# stored token (~/.config/gh/hosts.yml) if both are unset.
# DEPRECATED fallback only — the intended auth path is the source's own
# connector ref (#1528), not a node-wide token. Do not paste a long-lived
# personal access token here in production.
GITHUB_TOKEN=
GH_TOKEN=

NODE_ENV=
